rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // path: shops/{shopId}/products/{productId}/{fileName}
    match /shops/{shopId}/products/{productId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024 // จำกัด 5MB ต่อไฟล์
        && request.resource.contentType.matches('image/.*');
    }

    // path: shops/{shopId}/logo/{fileName}
    match /shops/{shopId}/logo/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
